#!/bin/sh
# Use the project-local runtime, or the exact Node/npm selected with nvm use.
set -eu
project_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
node_version=$(cat "$project_dir/.nvmrc")
case "$(uname -s)/$(uname -m)" in
  Darwin/arm64) node_platform=darwin-arm64 ;;
  Darwin/x86_64) node_platform=darwin-x64 ;;
  Linux/x86_64) node_platform=linux-x64 ;;
  Linux/aarch64) node_platform=linux-arm64 ;;
  *) node_platform=unsupported ;;
esac
local_bin="$project_dir/.tools/node-v$node_version-$node_platform/bin"
if [ -x "$local_bin/node" ]; then
  PATH="$local_bin:$PATH"
  export PATH
fi
if ! command -v npm >/dev/null 2>&1; then
  printf 'Use Node %s (nvm use) and npm 11.19.1 before running this command.\n' "$node_version" >&2
  exit 1
fi
cd "$project_dir"
exec npm "$@"
